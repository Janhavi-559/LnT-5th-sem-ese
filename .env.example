# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection
# Set your MongoDB Atlas or local URI here.
# If MONGO_URI is omitted or cannot be reached, the server automatically starts an in-memory MongoDB instance for zero-friction local testing!
MONGO_URI=mongodb://127.0.0.1:27017/digital_library_db

# JWT Configuration
JWT_SECRET=super_secret_university_lms_jwt_token_key_2026
JWT_EXPIRES_IN=7d

# Library Policy Configuration
FINE_RATE_PER_DAY=10
STUDENT_MAX_BOOKS=3
STUDENT_LOAN_DAYS=14
FACULTY_MAX_BOOKS=8
FACULTY_LOAN_DAYS=30

    {
      "name": "02 - Book Catalog Management (Module 2)",
      "item": [
        {
          "name": "2.1 Create Book (Librarian/Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.success && res.data._id) {",
                  "    pm.collectionVariables.set('sampleBookId', res.data._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{librarianToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Designing Data-Intensive Applications\",\n  \"author\": \"Martin Kleppmann\",\n  \"isbn\": \"978-1449373320\",\n  \"category\": \"Distributed Systems\",\n  \"totalCopies\": 4,\n  \"rackNumber\": \"DS-R2-08\",\n  \"edition\": \"1st Edition\",\n  \"publisher\": \"O'Reilly Media\",\n  \"price\": 1100,\n  \"description\": \"The definitive guide to the architecture of modern scalable data systems.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/books",
              "host": ["{{baseUrl}}"],
              "path": ["api", "books"]
            }
          }
        },
        {
          "name": "2.2 Get All Books (Paginated)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/books?page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "books"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "2.3 Get Book by ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/books/{{sampleBookId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "books", "{{sampleBookId}}"]
            }
          }
        },
        {
          "name": "2.4 Update Book",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{librarianToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"price\": 1250,\n  \"rackNumber\": \"DS-R2-09\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/books/{{sampleBookId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "books", "{{sampleBookId}}"]
            }
          }
        }
      ]
